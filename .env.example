# PostgreSQL. On Vercel use the pooled connection string for DATABASE_URL and the
# direct (unpooled) one for DIRECT_URL (used by migrations only).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Public base URL of this deployment, no trailing slash. The TikTok sign-in callback is
# ${APP_URL}/api/tiktok/oauth/callback
APP_URL="http://localhost:3000"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
SESSION_SECRET=""

# Safety switch. Every create, edit, pause and resume is refused by the server unless this
# is exactly "true". Leave it off until Settings -> Diagnostics has been run on the deployment.
TIKTOK_WRITES_ENABLED="false"

# Official TikTok for Business MCP endpoint
TIKTOK_MCP_URL="https://business-api.tiktok.com/open_mcp/tt-ads-mcp-flat"
